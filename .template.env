# Copy to .env. Nothing here is required.
#
# The binary reads OPENBETA_ENDPOINT from its own environment — an MCP client
# passes `env` to the subprocess, so that is the native mechanism. It does not
# read this file; the dotenv is for the test harness and for sourcing by hand.

OPENBETA_METRICS=/path/to/json/file.jsonl

# Where the server and the live tests point. Unset means the public API,
# https://api.openbeta.io/graphql. The -endpoint flag still overrides this.
# A local openbeta-graphql stack listens on port 4000.
OPENBETA_ENDPOINT=http://localhost:4000

OPENBETA_MAX_CRAGS=20

# Needed only by evals/judge/runner.py, which is the one part of the harness
# that calls a model. Everything above it runs without credentials.
ANTHROPIC_API_KEY=

# Required if, and only if, the key above is identity-linked — one tied to your
# user rather than to a workspace. Such a key spans workspaces, so the API will
# not guess which one to bill and rejects the request without this. The value
# must be a real "wrkspc_..." id: "default" and an empty string are both refused,
# so a key on the default workspace cannot be used at all. Either create a
# workspace and issue a key inside it (that key needs no id here), or copy the id
# from the Console URL when viewing the workspace.
ANTHROPIC_WORKSPACE_ID=